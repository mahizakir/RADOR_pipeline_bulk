Bootstrap: docker
From: docker.io/nvidia/cuda:12.6.3-cudnn-devel-ubuntu24.04
# https://docs.nvidia.com/deeplearning/frameworks/pytorch-release-notes/rel-25-02.html
%post
    # Basic tools
    # vLLM 0.10.1 + common extras you were using
    # Use the interpreter's pip and avoid caching to reduce disk usage during image build.
    # install python 3.10 and all dependencies
    APT_INSTALL="apt-get install -y --no-install-recommends"
    apt-get update &&
    DEBIAN_FRONTEND=noninteractive $APT_INSTALL \
        python3-full \
        python3-pip \
        python3-venv \
        ca-certificates
    ln -s /usr/bin/python3.12 /usr/local/bin/python

    mkdir -p /pip-cache
    # Create a dedicated virtual environment to isolate Python packages
    python3 -m venv /opt/venv
    # Ensure venv tools are up to date
    /opt/venv/bin/python -m pip install --upgrade pip setuptools wheel

    # Install runtime packages into the virtual environment (no pip cache)
    /opt/venv/bin/pip install --cache-dir /pip-cache \
        "vllm==0.10.1" \
        pandas numpy tqdm datasets \
        transformers \
        "bitsandbytes==0.48.2" \
        sentence_transformers

    # Clean up any residual caches
    rm -rf /root/.cache/pip
    rm -rf /pip-cache
    
    # (Optional) If you still want the CUDA compat hack for Triton-like behavior:
    #mkdir -p /usr/local/cuda/compat/lib
    #if [ -f /usr/lib64/libcuda.so ]; then
    #    ln -sf /usr/lib64/libcuda.so /usr/local/cuda/compat/lib/libcuda.so.1 || true
    #    ln -sf libcuda.so.1 /usr/local/cuda/compat/lib/libcuda.so || true
    #fi
    ldconfig

%environment
    export PYTHONNOUSERSITE=1
    export PYTHONWARNINGS="ignore::FutureWarning"
    export LD_PRELOAD=
    export CUDA_DEVICE_MAX_CONNECTIONS=1
    # Activate virtualenv installed at image build time
    export VIRTUAL_ENV=/opt/venv
    export PATH="$VIRTUAL_ENV/bin:$PATH"

%help
    To run vLLM 0.10.1:

      apptainer exec --nv vllm_0_10_1.sif \
        vllm serve <model_name_or_path> \
          --dtype auto \
          --tensor-parallel-size 1