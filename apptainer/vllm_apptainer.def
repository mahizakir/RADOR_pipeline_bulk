Bootstrap: docker
From: verlai/verl:app-verl0.5-transformers4.55.4-vllm0.10.0-mcore0.13.0-te2.2

%post
    pip install --no-cache-dir pandas sentence_transformers bitsandbytes>=0.46.1 
    # todo : install flashinfer
%environment
    # Prevent Python from using user site-packages from /home/<user>/.local
    export PYTHONNOUSERSITE=1
    # Suppress FutureWarning for pynvml
    export PYTHONWARNINGS="ignore::FutureWarning"
    # Prevent xalt bind
    export LD_PRELOAD=

%help
    To spawn the vllm server:
    $ apptainer exec --nv vllm_25.09.sif vllm serve <model_name>

    In case of a local model running from a folder not in your home space, include it with -B
    $ apptainer exec --nv -B <path_to_model> vllm_25.09.sif vllm serve <model_name>

EOF
